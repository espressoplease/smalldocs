{
  "name": "sdocs-server",
  "version": "1.6.2",
  "description": "SmallDocs server (smalldocs.org). Never published to npm. The CLI lives in cli/.",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node test/run.js",
    "parity": "node scripts/sdocs-parity.js",
    "test:cloud-e2e": "playwright test --config=playwright.cloud.config.js",
    "email:preview": "node scripts/email-preview.js",
    "email:preview:stop": "docker compose -p smalldocs-email-preview -f test/mailpit.compose.yml down",
    "eval:skill": "node scripts/smalldocs-skill-eval.js",
    "sdk:snapshot": "node scripts/build-sdk-reader-snapshot.js --version 0.3.0",
    "sdk:check": "node scripts/build-sdk-reader-snapshot.js --version 0.3.0 --check && node scripts/build-sdk-release-manifest.js --version 0.2.0 --check && node scripts/build-sdk-release-manifest.js --version 0.3.0 --check",
    "cloud:jobs": "node scripts/cloud-job-status.js",
    "cloud:jobs:retry": "node scripts/cloud-job-retry.js",
    "cloud:kms:smoke": "node ops/kms-failure-smoke.js",
    "cloud:kms:recovery-smoke": "node ops/kms-document-recovery-smoke.js"
  },
  "author": "Josh Summers",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espressoplease/smalldocs.git"
  },
  "homepage": "https://smalldocs.org",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1110.0",
    "@smithy/node-http-handler": "^4.11.0",
    "better-sqlite3": "^12.8.0",
    "brotli": "^1.3.3",
    "brotli-dec-wasm": "^2.3.2",
    "brotli-wasm": "^3.0.1",
    "marked": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "lucide-static": "^1.16.0"
  }
}
