NODE_ENV=production
CLOUD_MODE=staging
CLOUD_PUBLIC_MODE=enabled
HOST=127.0.0.1
PORT=3004
TRUST_PROXY=1

CLOUD_AUTH_PUBLIC_ORIGIN=https://cloud-staging.smalldocs.org
CLOUD_ENVIRONMENT=staging
CLOUD_AUTH_PEPPER=replace-with-independent-random-value
CLOUD_IDEMPOTENCY_SECRET=replace-with-independent-random-value
CLOUD_CURSOR_SECRET=replace-with-independent-random-value
CLOUD_MASTER_KEY=replace-with-disposable-32-byte-base64-key

# Optional exact-identity staging sign-in. Keep the secret in a systemd credential.
# CLOUD_TEST_LOGIN_ENABLED=1
# CLOUD_TEST_LOGIN_EMAILS=personal-demo@smalldocs.org,team-owner-demo@smalldocs.org
# CLOUD_TEST_LOGIN_SECRET_FILE=/run/credentials/smalldocs-staging.service/cloud-test-login-secret

CLOUD_AUTH_DB=/var/lib/smalldocs-staging/cloud_auth.db
CLOUD_OAUTH_DB=/var/lib/smalldocs-staging/cloud_oauth.db
CLOUD_DB=/var/lib/smalldocs-staging/cloud.db
CLOUD_BILLING_DB=/var/lib/smalldocs-staging/cloud_billing.db
CLOUD_JOBS_DB=/var/lib/smalldocs-staging/cloud_jobs.db

# OAuth providers are optional. Add both values for each enabled provider.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

NOTIFY_SMTP_HOST=smtp.resend.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=resend
NOTIFY_EMAIL_FROM=login@smalldocs.org

STRIPE_API_VERSION=2026-07-29.dahlia
STRIPE_PORTAL_CONFIGURATION_ID=replace-with-staging-portal-configuration-id
STRIPE_PERSONAL_PRICE_ID=replace-with-staging-personal-price-id
STRIPE_TEAM_PRICE_ID=replace-with-staging-team-price-id

CLOUD_PLAN_LIMITS_JSON='{"personal":{"maxStoredBytes":null,"maxFileBytes":10485760,"revisionRetentionDays":90,"maxProjects":null,"maxMembers":1,"search":{"maxRequests":null,"windowMs":null}},"team":{"maxStoredBytes":null,"maxFileBytes":10485760,"revisionRetentionDays":90,"maxProjects":null,"maxMembers":null,"search":{"maxRequests":null,"windowMs":null}}}'
CLOUD_REVISION_KEEP_PREVIOUS=3
CLOUD_REVISION_RETENTION_DAYS=90
CLOUD_DOCUMENT_RESTORE_WINDOW_MS=2592000000
CLOUD_WORKSPACE_RESTORE_WINDOW_MS=2592000000
CLOUD_OAUTH_PROVIDER_TIMEOUT_MS=10000

ANALYTICS_ENABLED=0
SHORT_LINKS_DB=/var/lib/smalldocs-staging/short_links.db
FEEDBACK_DB=/var/lib/smalldocs-staging/feedback.db
TEAMS_DB=/var/lib/smalldocs-staging/teams_interest.db
