NODE_ENV=production
CLOUD_MODE=off
HOST=127.0.0.1
PORT=3003
AWS_REGION=eu-central-1

ANALYTICS_ENABLED=0
ANALYTICS_DB=/var/lib/smalldocs/analytics/analytics.db
SHORT_LINKS_DB=/var/lib/smalldocs/short-links/short_links.db
FEEDBACK_DB=/var/lib/smalldocs/feedback/feedback.db
TEAMS_DB=/var/lib/smalldocs/teams/teams_interest.db

# Cloud launch policy. Cloud remains disabled until the private beta passes.
CLOUD_REVISION_KEEP_PREVIOUS=3
CLOUD_REVISION_RETENTION_DAYS=90
CLOUD_DOCUMENT_RESTORE_WINDOW_MS=2592000000
