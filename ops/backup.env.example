SDOCS_BACKUP_BUCKET=odd-solutions-smalldocs-prod-backups-ACCOUNT_ID
SDOCS_BACKUP_REGION=eu-central-1
SDOCS_BACKUP_ACCOUNT_ID=ACCOUNT_ID
# Set this path in /etc/smalldocs/backup-monitor.env after creating a
# root-owned file containing the HTTPS success-heartbeat URL.
# SDOCS_BACKUP_HEARTBEAT_URL_FILE=/etc/smalldocs/backup-heartbeat-url
