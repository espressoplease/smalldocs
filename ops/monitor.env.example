SDOCS_MONITOR_BACKUP_MAX_AGE_HOURS=26
SDOCS_MONITOR_DISK_WARNING_PERCENT=80
SDOCS_MONITOR_PENDING_MAX_AGE_MINUTES=15
SDOCS_MONITOR_REMINDER_HOURS=6
SDOCS_MONITOR_STATE_FILE=/var/lib/smalldocs-monitor/state.json
